# Copy to .env (never commit .env). Read by the API and the sync worker.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------- database (SQL Server)
DB_SERVER=sql.example.internal
DB_NAME=SWITRUS
DB_USER=switrus_app
DB_PASSWORD=change-me
# Older names SERVER / DATABASE / USER / PASSWORD still work.
# Local development without SQL Server: DB_ENGINE=sqlite (see README).
DB_ENGINE=mssql

# ---------------------------------------------------------------- secrets
# Signs the JWT returned by POST /login. Existing integrations may verify
# tokens with it, so keep the value they already use.
SECRET_KEY=change-me
# X-API-Key values accepted from trusted integrations (comma separated, use
# "old,new" while rotating). Empty = SECRET_KEY, which is how it worked before.
API_KEYS=
# Legacy ?api_key= in URLs. true only while integrations move to the X-API-Key
# header (each use is logged by key fingerprint); then set false.
ALLOW_API_KEY_QUERY=true
# Signs browser sessions. Required, at least 32 characters, different from SECRET_KEY.
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# ---------------------------------------------------------------- browser UI access
# Full access (create, edit, disable, leave), every branch.
ADMIN_ROLES=ADMIN
# Read-only, own branch AND own department.
UI_BRANCH_DEPARTMENT_ROLES=MANAGER
# Read-only, own branch, all departments.
UI_BRANCH_ROLES=BRANCHMANAGER
# Read-only, every branch (empty = nobody). Other roles cannot sign in.
UI_VIEWER_ROLES=
SESSION_TTL_MINUTES=480
# true in production (HTTPS). false only for plain-http local development.
SESSION_COOKIE_SECURE=true
# Extra origins allowed to use a session cookie (the UI is normally same-origin).
SESSION_ALLOWED_ORIGINS=
CORS_EXTRA_ORIGINS=
# POST /auth/login throttling: wrong passwords per user name + address per window.
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
# Development only, never needed: the UI has a sign-in page. When true, browser
# requests without a session act as UI_DEFAULT_EMPID. Refused when APP_ENV=production.
UI_AUTH_DISABLED=false
UI_DEFAULT_EMPID=

# ---------------------------------------------------------------- password reset e-mail (existing)
OTP_LENGTH=6
OTP_TTL_MINUTES=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
PASSWORD_PEPPER=
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Attendance Muster (optional, read-only)
# See docs/ATTENDANCE.md. Off until configured AND authorized below.
ATTENDANCE_CLIENT=disabled            # disabled | mock | http
ATTENDANCE_API_URL=                   # full https URL, no query string
ATTENDANCE_API_KEY=                   # server-side only; sent in the header below
ATTENDANCE_API_KEY_HEADER=x-api-key
ATTENDANCE_TIMEOUT_SECONDS=20
ATTENDANCE_MAX_RETRIES=1
ATTENDANCE_MAX_RANGE_DAYS=31
ATTENDANCE_CACHE_SECONDS=60
# none = admins see nothing | matched = Switrus employees, every branch | all = also unmatched records
ATTENDANCE_ADMIN_SCOPE=none
# true only after confirming employeeCode == SW_USER.EMPID on real data; until then managers see nothing.
ATTENDANCE_MAPPING_VERIFIED=false
ATTENDANCE_MOCK_EMPLOYEE_CODES=
ATTENDANCE_MOCK_FAILURE=none

# ---------------------------------------------------------------- Loyaltri HRMS (optional)
# See docs/LOYALTRI.md. Nothing here affects login or user management.
LOYALTRI_CLIENT=disabled              # disabled | mock | http
LOYALTRI_SYNC_ENABLED=false           # scheduled syncs; manual "Sync now" works either way
LOYALTRI_SYNC_INTERVAL_MINUTES=60
LOYALTRI_SCHEDULER=embedded           # embedded (thread in API) | external (sync-worker) | off
LOYALTRI_POLL_SECONDS=15

# HTTP adapter: every value below must come from Loyaltri's API documentation.
LOYALTRI_BASE_URL=
LOYALTRI_EMPLOYEES_PATH=
LOYALTRI_AUTH_HEADER=
LOYALTRI_AUTH_SCHEME=
LOYALTRI_API_KEY=
LOYALTRI_EXTRA_QUERY=
LOYALTRI_TIMEOUT_SECONDS=15
LOYALTRI_MAX_RETRIES=3
LOYALTRI_RETRY_BACKOFF_SECONDS=1
LOYALTRI_RECORDS_PATH=
LOYALTRI_PAGINATION=none              # none | page | offset | cursor
LOYALTRI_PAGE_PARAM=
LOYALTRI_PAGE_SIZE_PARAM=
LOYALTRI_PAGE_SIZE=100
LOYALTRI_FIRST_PAGE=1
LOYALTRI_CURSOR_PARAM=
LOYALTRI_NEXT_CURSOR_PATH=
LOYALTRI_MAX_PAGES=500
# JSON: Switrus field -> Loyaltri field path. emp_id is required.
LOYALTRI_FIELD_MAP=

# Field ownership policy
LOYALTRI_OWNED_FIELDS=phone,manager_id
LOYALTRI_FILL_EMPTY_FIELDS=email,department_id,branch_id
LOYALTRI_OVERWRITE_LOCAL_CHANGES=false
LOYALTRI_CREATE_MODE=off              # off | disabled
LOYALTRI_DEFAULT_ROLE=

# Mock client (development)
LOYALTRI_MOCK_FILE=
LOYALTRI_MOCK_FAILURE=none            # none | outage | timeout | server_error | auth_error
